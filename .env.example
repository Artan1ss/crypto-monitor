DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/btc_monitor
BYBIT_REST_URL=https://api.bybit.com
BYBIT_SPOT_WS_URL=wss://stream.bybit.com/v5/public/spot
BYBIT_LINEAR_WS_URL=wss://stream.bybit.com/v5/public/linear
SYMBOL=BTCUSDT
TELEGRAM_ENABLED=false
FIVE_MINUTE_TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ORDERBOOK_ENABLED=false
SEND_STARTUP_MESSAGE=false
LOG_LEVEL=INFO
CVD_WARMUP_BARS=12
PIVOT_LEFT=3
PIVOT_RIGHT=3
PIVOT_MIN_AGE=6
PIVOT_MAX_AGE=72
OI_CHANGE_THRESHOLD_PCT=0.25
FUNDING_SUPPORTIVE=0.0001
FUNDING_EXTREME=0.0003
VOLUME_MULTIPLIER=1.30
SIGNAL_MIN_SCORE=4.5
STRONG_SIGNAL_SCORE=6.0
SIGNAL_COOLDOWN_MIN=30
TICKER_PERSIST_SECONDS=5
WS_STALE_SECONDS=30
WS_ALERT_SECONDS=60
HEARTBEAT_SECONDS=20
TRACKING_FEE_BPS_PER_SIDE=0
TRACKING_SLIPPAGE_BPS_PER_SIDE=0
# Independent BTC research archive. No new squeeze notifications or strategy changes.
ARCHIVE_ENABLED=false
ARCHIVE_VENUES=["bybit","binance","okx","coinbase"]
ARCHIVE_GRACE_SECONDS=10
ARCHIVE_POLL_SECONDS=60
ARCHIVE_QUEUE_SIZE=5000
BINANCE_SPOT_REST_URL=https://api.binance.com
BINANCE_LINEAR_REST_URL=https://fapi.binance.com
BINANCE_SPOT_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_LINEAR_WS_URL=wss://fstream.binance.com/market/ws
OKX_REST_URL=https://openapi.okx.com
OKX_PUBLIC_WS_URL=wss://ws.okx.com:8443/ws/v5/public
COINBASE_REST_URL=https://api.exchange.coinbase.com
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
# Optional Coinalyze research source. Key stays in .env/Railway, never in Git.
COINALYZE_ENABLED=false
COINALYZE_API_KEY=
COINALYZE_POLL_SECONDS=120
COINALYZE_REQUESTS_PER_MINUTE=25
# unknown triggers conservative reference checks; failed checks remain unnormalized.
COINALYZE_SPOT_VOLUME_UNIT=unknown
COINALYZE_FUNDING_UNIT=percent
# Independent, closed-hour pressure alerts. Does not modify V1.
HOURLY_ENABLED=false
HOURLY_TELEGRAM_ENABLED=false
HOURLY_SOURCE=coinalyze
HOURLY_STRATEGY=sweep
HOURLY_DECISION_DELAY_SECONDS=180
HOURLY_CONTEXT_HOURS=48
HOURLY_FLOW_HOURS=6
HOURLY_PRESSURE_THRESHOLD=0.05
HOURLY_PRICE_MOVE_ATR=0.15
HOURLY_LEVEL_TOLERANCE_ATR=0.25
HOURLY_COOLDOWN_HOURS=4
# Blank => loopback only for dashboard/data endpoints; keep Railway private.
# If intentionally exposing HTTPS, set a long random password; username: monitor.
DASHBOARD_PASSWORD=
